<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The probe exists to talk to USB Audio devices in host mode. -->
    <uses-feature android:name="android.hardware.usb.host" android:required="true" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- M2.3: the session lives in a foreground service so it survives the
         activity and the screen turning off. Raw isochronous URBs bypass
         AudioFlinger, so the partial wake lock is what keeps the CPU awake
         during a screen-off soak. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:label="USBCHECK"
        android:allowBackup="false">

        <activity
            android:name=".MainActivity"
            android:launchMode="singleTop"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Offer the probe when a USB Audio device is attached. -->
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>
            <meta-data
                android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"
                android:resource="@xml/usb_device_filter" />
        </activity>

        <!-- Exported so adb can drive it with `am startservice`; this is a
             developer-only probe and every command just talks to USB. -->
        <service
            android:name=".ProbeService"
            android:foregroundServiceType="connectedDevice"
            android:exported="true" />
    </application>
</manifest>
