# TONE3000 plugin build configuration. Copy to `.env` (gitignored) at the
# repo root; `.env.local` overrides it, and a variable set in the configure
# environment overrides both. CMake reads these at configure time into the
# generated T3kConfig.h (plugin/ui/NativeUi.cmake); reconfigure after a change.

# Required. The TONE3000 publishable key: the OAuth client_id the plugin uses
# to sign the user in. Without it, sign-in surfaces an error. The value below
# is the community key, for source builds and distro packages. It is a client
# ID, not a secret, so it is fine to ship in a binary. Official releases use
# their own key; to use yours, make one at tone3000.com > Settings > API Keys.
# Sign-in completes through a loopback redirect (http://localhost:<port>/),
# which is auto-allowed for publishable keys, so nothing else needs
# registering.
T3K_PUBLISHABLE_KEY=t3k_pub_Ej7NYu-huVjA5TwLPTb_7xTblnD4ghQG

# Optional. The TONE3000 API origin (no trailing slash). Defaults to
# production; set it to point at a staging deployment or a local server.
# T3K_API_DOMAIN=https://www.tone3000.com

# Optional. When "true", the plugin fetches ${T3K_API_DOMAIN}/api/v1/plugin/version
# once on startup and shows an "update available" notice if that version is
# newer than the running build. Off by default (forks).
# T3K_UPDATE_NOTICE=true
