# ── Required ──────────────────────────────────────────────────────────────────
# Your TONE3000 publishable key. Generate one at tone3000.com → Settings → API
# Keys; it looks like `t3k_pub_…`. Used as the OAuth `client_id` whenever the
# plugin starts the Select flow (`prompt=select_tone`). Without it, clicking
# "+" inside the plugin will surface an error instead of opening tone3000.com.
VITE_T3K_PUBLISHABLE_KEY=t3k_pub_your_key_here

# ── Optional ──────────────────────────────────────────────────────────────────
# Override the TONE3000 API origin (no trailing slash). Defaults to production:
# https://www.tone3000.com. Set this when pointing at a staging deployment or
# local dev server.
# VITE_T3K_API_DOMAIN=https://staging.tone3000.com

# Update notice. When "true", the plugin pings ${T3K_API}/api/v1/plugin/version
# once on startup and shows an "update available" notice if the returned
# version is newer than the running build. Off by default (forks).
# VITE_T3K_UPDATE_NOTICE=true

# ── Redirect URIs ─────────────────────────────────────────────────────────────
# The plugin computes its redirect URI at runtime from `window.location.origin
# + window.location.pathname` so it stays correct across builds. Make sure the
# following URIs are added to your publishable key's allowed redirect URIs in
# TONE3000 → Settings → API Keys (localhost is auto-allowed in dev):
#
#   Vite dev:        http://localhost:5173/
#   macOS / Linux:   juce://juce.backend/index.html
#   Windows:         https://juce.backend/index.html
