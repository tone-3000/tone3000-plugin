  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@eslint/js": "^9.30.1",
    "prettier": "^3.4.2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "cross-env": "^7.0.3",
